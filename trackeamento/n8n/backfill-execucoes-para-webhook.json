{
  "name": "Template Backfill - Reenviar execuções pra webhook",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "id": "b1a2c3d4-0001-4000-8000-000000000001",
      "name": "Iniciar backfill"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c2b3d4e5-0002-4000-8000-000000000002",
              "name": "n8n_api_base_url",
              "value": "COLE_A_URL_BASE_DA_API_DO_N8N_AQUI",
              "type": "string"
            },
            {
              "id": "d3c4e5f6-0003-4000-8000-000000000003",
              "name": "workflow_id_origem",
              "value": "COLE_O_ID_DO_WORKFLOW_QUE_FILTROU_OS_SUCESSOS",
              "type": "string"
            },
            {
              "id": "e4d5f6a7-0004-4000-8000-000000000004",
              "name": "nome_node_webhook_origem",
              "value": "COLE_O_NOME_DO_NODE_DE_WEBHOOK_NO_WORKFLOW_ORIGEM",
              "type": "string"
            },
            {
              "id": "f5e6a7b8-0005-4000-8000-000000000005",
              "name": "webhook_url_destino",
              "value": "COLE_A_URL_DO_WEBHOOK_DO_FLUXO_DE_TRACKEAMENTO",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        0
      ],
      "id": "a6f7b8c9-0006-4000-8000-000000000006",
      "name": "Config Backfill"
    },
    {
      "parameters": {
        "url": "=https://{{ $json.n8n_api_base_url }}/executions",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "workflowId",
              "value": "={{ $json.workflow_id_origem }}"
            },
            {
              "name": "status",
              "value": "success"
            },
            {
              "name": "limit",
              "value": "250"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        0
      ],
      "id": "b7a8c9d0-0007-4000-8000-000000000007",
      "name": "Listar execuções com sucesso",
      "credentials": {
        "httpHeaderAuth": {
          "id": "COLE_O_ID_DA_CREDENCIAL_AQUI",
          "name": "n8n API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// A API do n8n devolve { data: [ {id, ...}, ... ], nextCursor }\n// Se nextCursor não vier nulo, tem mais de 250 execuções e precisa rodar de novo\n// ajustando o parâmetro 'cursor' na chamada acima (paginação manual).\nconst lista = $input.first().json.data || [];\n\nif ($input.first().json.nextCursor) {\n  console.log('AVISO: existem mais execuções além das 250 retornadas. Rode de novo com o cursor: ' + $input.first().json.nextCursor);\n}\n\nreturn lista.map(exec => ({ json: { id: exec.id } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "id": "c8b9d0e1-0008-4000-8000-000000000008",
      "name": "Extrair lista de IDs"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1120,
        0
      ],
      "id": "d9c0e1f2-0009-4000-8000-000000000009",
      "name": "Loop (1 por vez)"
    },
    {
      "parameters": {
        "url": "=https://{{ $('Config Backfill').item.json.n8n_api_base_url }}/executions/{{ $json.id }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "includeData",
              "value": "true"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        -120
      ],
      "id": "e0d1f2a3-0010-4000-8000-000000000010",
      "name": "Buscar execução completa",
      "credentials": {
        "httpHeaderAuth": {
          "id": "COLE_O_ID_DA_CREDENCIAL_AQUI",
          "name": "n8n API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Puxa o payload original que o node de webhook recebeu, dentro do histórico da execução\nconst nomeNode = $('Config Backfill').item.json.nome_node_webhook_origem;\nconst execucao = $input.first().json;\n\nconst runData = execucao?.data?.resultData?.runData?.[nomeNode];\nif (!runData) {\n  throw new Error('Não achei o node \"' + nomeNode + '\" no histórico da execução ' + execucao.id + '. Confirma o nome exato do node no workflow de origem.');\n}\n\nconst itemOriginal = runData[0]?.data?.main?.[0]?.[0]?.json;\nif (!itemOriginal || !itemOriginal.body) {\n  throw new Error('Execução ' + execucao.id + ' não tem body no formato esperado.');\n}\n\n// itemOriginal.body é exatamente o que a NeoAI mandou originalmente (ex: { data: {...} })\nreturn [{ json: itemOriginal.body }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        -120
      ],
      "id": "f1e2a3b4-0011-4000-8000-000000000011",
      "name": "Extrair payload original"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config Backfill').item.json.webhook_url_destino }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        -120
      ],
      "id": "a2f3b4c5-0012-4000-8000-000000000012",
      "name": "Reenviar pro webhook de produção"
    },
    {
      "parameters": {
        "amount": 1
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2000,
        -120
      ],
      "id": "b3a4c5d6-0013-4000-8000-000000000013",
      "name": "Esperar 1s (rate limit)",
      "webhookId": "b3a4c5d6-0013-4000-8000-000000000013"
    }
  ],
  "connections": {
    "Iniciar backfill": {
      "main": [
        [
          {
            "node": "Config Backfill",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config Backfill": {
      "main": [
