  "functions": [
    {
      "schema": "privado",
      "name": "eh_agencia",
      "definition": "CREATE OR REPLACE FUNCTION privado.eh_agencia()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select exists (select 1 from public.agencia_admins where user_id = (select auth.uid()));\n$function$\n"
    },
    {
      "schema": "privado",
      "name": "papel_na_empresa",
      "definition": "CREATE OR REPLACE FUNCTION privado.papel_na_empresa(p_empresa uuid)\n RETURNS papel_membro\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select papel from public.membros where empresa_id = p_empresa and user_id = (select auth.uid());\n$function$\n"
    },
    {
      "schema": "privado",
      "name": "pode_administrar_empresa",
      "definition": "CREATE OR REPLACE FUNCTION privado.pode_administrar_empresa(p_empresa uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select privado.eh_agencia() or privado.papel_na_empresa(p_empresa) = 'dono';\n$function$\n"
    },
    {
      "schema": "privado",
      "name": "pode_editar_lead",
      "definition": "CREATE OR REPLACE FUNCTION privado.pode_editar_lead(p_empresa uuid, p_responsavel uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select privado.eh_agencia()\n      or privado.papel_na_empresa(p_empresa) in ('dono', 'gestor')\n      or (privado.papel_na_empresa(p_empresa) = 'vendedor' and p_responsavel = (select auth.uid()));\n$function$\n"
    },
    {
      "schema": "privado",
      "name": "pode_ver_empresa",
      "definition": "CREATE OR REPLACE FUNCTION privado.pode_ver_empresa(p_empresa uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select privado.eh_agencia() or privado.papel_na_empresa(p_empresa) is not null;\n$function$\n"
    },
    {
      "schema": "privado",
      "name": "pode_ver_lead",
      "definition": "CREATE OR REPLACE FUNCTION privado.pode_ver_lead(p_empresa uuid, p_responsavel uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select privado.eh_agencia()\n      or privado.papel_na_empresa(p_empresa) in ('dono', 'gestor', 'leitura')\n      or (privado.papel_na_empresa(p_empresa) = 'vendedor' and p_responsavel = (select auth.uid()));\n$function$\n"
    }
  ]
}
