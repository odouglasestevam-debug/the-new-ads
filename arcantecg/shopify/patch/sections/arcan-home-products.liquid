{% assign selection = section.settings.collection %}
{% if selection != blank %}
<section class="container shop-section arcan-catalog" id="arcan-catalog-{{ section.id }}" aria-labelledby="arcan-heading-{{ section.id }}">
  <div class="section-heading"><div><h2 id="arcan-heading-{{ section.id }}">{{ section.settings.title | escape }}</h2>{% if section.settings.caption != blank %}<p>{{ section.settings.caption | escape }}</p>{% endif %}</div><a class="text-link" href="{{ selection.url }}">Explorar coleção <svg class="icon" aria-hidden="true"><use href="#arcan-icon-arrow"/></svg></a></div>
  {% if section.settings.show_filters %}<div class="filters" aria-label="Explorar por formato"><a href="{{ selection.url }}" data-arcan-panel="arcan-panel-{{ section.id }}-all" aria-current="true">Todos</a>{% if section.settings.cards_collection != blank %}<a href="{{ section.settings.cards_collection.url }}" data-arcan-panel="arcan-panel-{{ section.id }}-cards">Cartas avulsas</a>{% endif %}{% if section.settings.boosters_collection != blank %}<a href="{{ section.settings.boosters_collection.url }}" data-arcan-panel="arcan-panel-{{ section.id }}-boosters">Boosters</a>{% endif %}{% if section.settings.kits_collection != blank %}<a href="{{ section.settings.kits_collection.url }}" data-arcan-panel="arcan-panel-{{ section.id }}-kits">Boxes e kits</a>{% endif %}</div>{% endif %}
  <div class="product-grid" id="arcan-panel-{{ section.id }}-all" data-arcan-products>{% for product in selection.products limit: section.settings.limit %}{% render 'arcan-product-card', product: product %}{% else %}<p>Novos produtos estarão aqui em breve.</p>{% endfor %}</div>
  {% if section.settings.show_filters %}{% assign keys = 'cards,boosters,kits' | split: ',' %}{% for key in keys %}{% assign setting_key = key | append: '_collection' %}{% assign tab_collection = section.settings[setting_key] %}{% if tab_collection != blank %}<div class="product-grid" id="arcan-panel-{{ section.id }}-{{ key }}" data-arcan-products hidden>{% for product in tab_collection.products limit: section.settings.limit %}{% render 'arcan-product-card', product: product %}{% else %}<p>Nenhum produto disponível nesta coleção.</p>{% endfor %}</div>{% endif %}{% endfor %}{% endif %}
  <p class="sr-only" data-arcan-announcement aria-live="polite"></p>
</section>
{% endif %}
{% schema %}
{"name":"Arcan · Vitrine","settings":[{"type":"text","id":"title","label":"Título","default":"Os próximos favoritos da sua coleção."},{"type":"text","id":"caption","label":"Descrição","default":"Descubra os produtos da Arcan TCG."},{"type":"collection","id":"collection","label":"Coleção principal"},{"type":"range","id":"limit","label":"Produtos por seleção","min":4,"max":12,"step":4,"default":4},{"type":"checkbox","id":"show_filters","label":"Mostrar seleção por formato","default":true},{"type":"collection","id":"cards_collection","label":"Cartas avulsas"},{"type":"collection","id":"boosters_collection","label":"Boosters"},{"type":"collection","id":"kits_collection","label":"Boxes e kits"}],"presets":[{"name":"Arcan · Vitrine"}]}
{% endschema %}
