{% assign featured = section.settings.product %}
<section class="container beginner-section" id="comecar"><div class="beginner-image">{% if featured.featured_image %}{{ featured.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(max-width: 760px) 80vw, 390px', alt: featured.title }}{% endif %}<span>Todo colecionador tem uma primeira carta.</span></div><div class="beginner-copy"><h2>{{ section.settings.title | escape | newline_to_br }}</h2><p>{{ section.settings.description | escape }}</p><div class="beginner-options"><a href="{{ collections['blister-unitario'].url }}"><span><strong>Quero a surpresa de abrir</strong><small>Explore boosters e descubra o que vem dentro.</small></span><svg class="icon" aria-hidden="true"><use href="#arcan-icon-arrow"/></svg></a><a href="{{ collections['raras'].url }}"><span><strong>Já tenho um Pokémon favorito</strong><small>Encontre cartas avulsas para sua coleção.</small></span><svg class="icon" aria-hidden="true"><use href="#arcan-icon-arrow"/></svg></a><a href="{{ collections['etb'].url }}"><span><strong>Quero conhecer os kits</strong><small>Veja os kits e confira o conteúdo de cada produto.</small></span><svg class="icon" aria-hidden="true"><use href="#arcan-icon-arrow"/></svg></a></div></div></section>
{% schema %}{"name": "Arcan - Iniciantes", "settings": [{"type": "textarea", "id": "title", "label": "T\u00edtulo", "default": "Sua cole\u00e7\u00e3o come\u00e7a\ncom uma boa escolha."}, {"type": "textarea", "id": "description", "label": "Descri\u00e7\u00e3o", "default": "N\u00e3o precisa entender tudo para come\u00e7ar. Descubra o formato que combina com o seu jeito de colecionar."}, {"type": "product", "id": "product", "label": "Produto para ilustrar"}], "presets": [{"name": "Arcan - Iniciantes"}]}{% endschema %}
